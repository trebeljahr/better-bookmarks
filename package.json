{
  "name": "better-bookmarks",
  "version": "1.0.0-rc.1",
  "packageManager": "pnpm@10.33.2",
  "description": "better-bookmarks",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "build:favicons": "node scripts/build-favicons.mjs",
    "build:press-kit": "node scripts/build-press-kit.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "vite": "^8.0.0",
      "adm-zip": "^0.6.1",
      "protobufjs": "^7.6.5",
      "sharp": "^0.35.4",
      "@tootallnate/once": "^2.0.1",
      "node-notifier>uuid": "^11.1.1",
      "shell-quote": "^1.9.0",
      "tmp": "^0.2.6",
      "esbuild": "^0.28.1"
    }
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trebeljahr/better-bookmarks.git"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "4.4.2",
    "franc-min": "^6.2.0",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-window": "^1.8.11",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ulid": "^2.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "0.1.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^1.8.8",
    "@wxt-dev/module-react": "^1.2.2",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "wxt": "^0.20.27"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
