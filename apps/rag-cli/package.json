    "test:security": "tsx --test src/serve.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "p-limit": "^6.2.0",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cli-progress": "^3.11.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
